# ---------------------------------------------------------------------------
# Clerk — https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Webhooks -> Add Endpoint -> https://<your-domain>/api/webhooks/clerk
# Subscribe to user.created and user.updated, then copy the signing secret.
CLERK_WEBHOOK_SECRET=whsec_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# ---------------------------------------------------------------------------
# Neon Postgres — https://vercel.com/marketplace/neon
# The Vercel integration sets DATABASE_URL on the project automatically; set it
# by hand only for local development. POSTGRES_URL is read as a fallback so a
# legacy Vercel Postgres store keeps working.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://...
